{%- comment -%}
  Renders a product price with optional compare-at price and saving.
  Usage: {% render 'price', product: product, show_saving: true %}
{%- endcomment -%}
{%- liquid
  assign target = product.selected_or_first_available_variant | default: product
  assign price_now = target.price
  assign price_was = target.compare_at_price
-%}
<div class="g-price">
  <span class="g-visually-hidden">Price</span>
  <span class="g-price__now" data-g-price-now>{{ price_now | money_without_trailing_zeros }}</span>
  {%- if price_was > price_now -%}
    <span class="g-visually-hidden">Regular price</span>
    <s class="g-price__was" data-g-price-was>{{ price_was | money_without_trailing_zeros }}</s>
    {%- if show_saving -%}
      <span class="g-price__save">Save {{ price_was | minus: price_now | money_without_trailing_zeros }}</span>
    {%- endif -%}
  {%- endif -%}
</div>
