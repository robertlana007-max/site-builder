<div class="g-overlay" data-g-overlay></div>

<aside class="g-drawer g-drawer--right" data-g-drawer="cart" aria-hidden="true" aria-label="Your cart">
  <div class="g-drawer__head">
    <h2 class="g-drawer__title">Your cart</h2>
    <button type="button" class="g-icon-btn" data-g-close aria-label="Close cart">
      {% render 'icon', name: 'close' %}
    </button>
  </div>

  <div class="g-drawer__body" data-g-cart-items>
    {%- if cart.item_count == 0 -%}
      <div class="g-cart-empty">
        {% render 'icon', name: 'bag' %}
        <p>Your cart is empty</p>
        <a class="g-btn g-btn--sm" href="{{ routes.all_products_collection_url }}">Shop the range</a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="g-line" data-line="{{ forloop.index }}">
          {%- if item.image -%}
            <img class="g-line__img" src="{{ item.image | image_url: width: 200 }}" alt="" loading="lazy" width="78" height="96">
          {%- else -%}
            <div class="g-line__img"></div>
          {%- endif -%}
          <div>
            <a class="g-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
            <div class="g-line__row">
              <div class="g-qty">
                <button type="button" class="g-qty__btn" data-g-line-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity">&minus;</button>
                <span class="g-qty__input">{{ item.quantity }}</span>
                <button type="button" class="g-qty__btn" data-g-line-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity">+</button>
              </div>
              <span class="g-line__price">{{ item.final_line_price | money_without_trailing_zeros }}</span>
            </div>
            <button type="button" class="g-line__remove" data-g-line-qty="0">Remove</button>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="g-drawer__foot" data-g-cart-foot {% if cart.item_count == 0 %}hidden{% endif %}>
    <div class="g-cart-total">
      <span>Total</span>
      <span data-g-cart-total>{{ cart.total_price | money_without_trailing_zeros }}</span>
    </div>
    <p class="g-drawer__note">Free delivery &middot; Pay cash when your parcel arrives</p>
    <a
      class="g-btn g-btn--block"
      href="{% if settings.custom_checkout_url != blank %}{{ settings.custom_checkout_url }}{% else %}{{ routes.root_url | append: 'checkout' | replace: '//', '/' }}{% endif %}"
    >
      Checkout &middot; Cash on Delivery
      {% render 'icon', name: 'arrow' %}
    </a>
  </div>

  <template data-g-cart-empty>
    <div class="g-cart-empty">
      {% render 'icon', name: 'bag' %}
      <p>Your cart is empty</p>
      <a class="g-btn g-btn--sm" href="{{ routes.all_products_collection_url }}">Shop the range</a>
    </div>
  </template>
</aside>
