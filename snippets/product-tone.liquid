{%- comment -%}
  Outputs a colour tone name for a product, based on its handle.
  Usage: {% capture tone %}{% render 'product-tone', handle: product.handle %}{% endcapture %}
{%- endcomment -%}
{%- liquid
  if handle contains 'deal' or handle contains 'kit' or handle contains 'bundle'
    echo 'peach'
  elsif handle contains 'charcoal'
    echo 'ink'
  elsif handle contains 'lemon'
    echo 'lemon'
  elsif handle contains 'herbal' or handle contains 'aloe'
    echo 'mint'
  else
    echo 'pink'
  endif
-%}
