{%- comment -%}
  A little product character with a face.
  Usage: {% render 'mascot', tone: 'pink' %}  (pink = cream jar, ink = charcoal, lemon, mint = herbal, peach = jar)
{%- endcomment -%}
{%- liquid
  assign body = '#F7A8C0'
  assign cap = '#D4537E'
  assign shape = 'jar'
  case tone
    when 'ink'
      assign body = '#5A5568'
      assign cap = '#2E2A3A'
      assign shape = 'tube'
    when 'lemon'
      assign body = '#FFDD55'
      assign cap = '#F2B705'
      assign shape = 'tube'
    when 'mint'
      assign body = '#9EDDB0'
      assign cap = '#4FAE6E'
      assign shape = 'tube'
    when 'peach'
      assign body = '#FFC59E'
      assign cap = '#F08A4B'
  endcase
-%}
<svg class="g-mascot" viewBox="0 0 96 104" aria-hidden="true" focusable="false">
  <ellipse cx="48" cy="98" rx="26" ry="4" fill="#4B1528" opacity=".14"/>
  {%- if shape == 'tube' -%}
    <path d="M26 14h44l6 62a8 8 0 0 1-8 9H28a8 8 0 0 1-8-9z" fill="{{ body }}" stroke="#4B1528" stroke-width="3" stroke-linejoin="round"/>
    <rect x="30" y="83" width="36" height="12" rx="4" fill="{{ cap }}" stroke="#4B1528" stroke-width="3"/>
    <path d="M24 14h48" stroke="#4B1528" stroke-width="5" stroke-linecap="round"/>
  {%- else -%}
    <rect x="16" y="20" width="64" height="18" rx="7" fill="{{ cap }}" stroke="#4B1528" stroke-width="3"/>
    <rect x="12" y="36" width="72" height="56" rx="16" fill="{{ body }}" stroke="#4B1528" stroke-width="3"/>
  {%- endif -%}
  <g class="g-mascot__face">
    <g class="g-mascot__eyes" fill="#4B1528">
      <ellipse cx="38" cy="56" rx="4" ry="5"/>
      <ellipse cx="58" cy="56" rx="4" ry="5"/>
    </g>
    <circle cx="39.5" cy="54" r="1.4" fill="#fff"/>
    <circle cx="59.5" cy="54" r="1.4" fill="#fff"/>
    <path d="M41 65q7 7 14 0" fill="none" stroke="#4B1528" stroke-width="3" stroke-linecap="round"/>
    <ellipse cx="30" cy="64" rx="5" ry="3" fill="#FF8FB0" opacity=".75"/>
    <ellipse cx="66" cy="64" rx="5" ry="3" fill="#FF8FB0" opacity=".75"/>
  </g>
  <path class="g-mascot__spark" d="M84 14l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" fill="#FFDD55" stroke="#4B1528" stroke-width="2" stroke-linejoin="round"/>
</svg>
