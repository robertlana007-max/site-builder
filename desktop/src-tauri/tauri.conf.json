{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GetToolNest",
  "version": "1.1.0",
  "identifier": "xyz.gettoolnest.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "GetToolNest",
    "copyright": "GetToolNest",
    "category": "Utility",
    "shortDescription": "Free online tools",
    "longDescription": "GetToolNest: free tools for PDFs, images, video, text and calculators in one app.",
    "homepage": "https://gettoolnest.xyz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
