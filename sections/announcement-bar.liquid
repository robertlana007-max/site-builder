{%- if section.blocks.size > 0 -%}
  <div class="g-announce" role="region" aria-label="Announcements">
    <div class="g-announce__track">
      {%- for i in (1..2) -%}
        <div class="g-announce__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
          {%- for n in (1..3) -%}
            {%- for block in section.blocks -%}
              <span class="g-announce__item" {% if i == 1 and n == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {{- block.settings.text | escape -}}
              </span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Cash on Delivery all over Pakistan"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message"
        }
      ]
    }
  ]
}
{% endschema %}
