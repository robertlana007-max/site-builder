{%- liquid
  assign is_raw = false
  assign raw_handles = settings.raw_page_handles | split: ','
  for raw_handle in raw_handles
    assign clean_handle = raw_handle | strip
    if clean_handle == page.handle
      assign is_raw = true
    endif
  endfor
  assign wa = settings.whatsapp_number | remove: '+' | remove: ' '
-%}

{%- if is_raw -%}
  {%- comment -%} Custom checkout / thank-you pages: output exactly as written, no theme styling. {%- endcomment -%}
  <div class="g-raw">{{ page.content }}</div>

{%- elsif page.handle == section.settings.contact_handle -%}
  <section class="g-pagehero">
    <div class="g-container">
      <ol class="g-crumbs">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li aria-current="page">{{ page.title | escape }}</li>
      </ol>
      <h1 class="g-h1">Say <em>hello!</em></h1>
      <p class="g-lead">{{ section.settings.contact_text | escape }}</p>
    </div>
  </section>

  <section class="g-section g-section--tight">
    <div class="g-container">
      <div class="g-contact">
        <div class="g-contact__cards">
          {%- if wa != blank -%}
            <a class="g-ccard g-reveal" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">
              <span class="g-ccard__icon">{% render 'icon', name: 'whatsapp' %}</span>
              <span>
                <span class="g-ccard__k">WhatsApp / Phone</span>
                <span class="g-ccard__v" style="display:block">{{ settings.whatsapp_display | default: wa | escape }}</span>
              </span>
            </a>
          {%- endif -%}
          {%- if settings.contact_email != blank -%}
            <a class="g-ccard g-reveal" href="mailto:{{ settings.contact_email | escape }}">
              <span class="g-ccard__icon">{% render 'icon', name: 'mail' %}</span>
              <span>
                <span class="g-ccard__k">Email</span>
                <span class="g-ccard__v" style="display:block">{{ settings.contact_email | escape }}</span>
              </span>
            </a>
          {%- endif -%}
          {%- if settings.contact_hours != blank -%}
            <div class="g-ccard g-reveal">
              <span class="g-ccard__icon">{% render 'icon', name: 'clock' %}</span>
              <span>
                <span class="g-ccard__k">Hours</span>
                <span class="g-ccard__v" style="display:block">{{ settings.contact_hours | escape }}</span>
              </span>
            </div>
          {%- endif -%}
          {%- if settings.contact_address != blank -%}
            <div class="g-ccard g-reveal">
              <span class="g-ccard__icon">{% render 'icon', name: 'pin' %}</span>
              <span>
                <span class="g-ccard__k">Address</span>
                <span class="g-ccard__v" style="display:block">{{ settings.contact_address | escape }}</span>
              </span>
            </div>
          {%- endif -%}
          {%- if page.content != blank -%}
            <details class="g-faq__item">
              <summary class="g-faq__q" style="font-size:18px">Business details</summary>
              <div class="g-faq__a g-rte">{{ page.content }}</div>
            </details>
          {%- endif -%}
        </div>

        <div class="g-formcard g-reveal">
          <h2 class="g-h3" style="margin-bottom:6px">Send us a message</h2>
          <p style="margin:0 0 20px;color:var(--g-ink-soft)">We reply Monday to Saturday.</p>
          {%- form 'contact', class: 'g-form', id: 'ContactForm' -%}
            {%- if form.posted_successfully? -%}
              <p class="g-alert" role="status">Thank you. Your message has been sent.</p>
            {%- elsif form.errors -%}
              <p class="g-alert g-alert--error" role="alert">Please check the form and try again.</p>
            {%- endif -%}
            <div class="g-form__two">
              <label class="g-field">
                <span class="g-field__label">Name</span>
                <input class="g-input" type="text" name="contact[name]" autocomplete="name" required>
              </label>
              <label class="g-field">
                <span class="g-field__label">Phone</span>
                <input class="g-input" type="tel" name="contact[phone]" autocomplete="tel" placeholder="03xx xxxxxxx">
              </label>
            </div>
            <label class="g-field">
              <span class="g-field__label">Email</span>
              <input class="g-input" type="email" name="contact[email]" autocomplete="email" required>
            </label>
            <label class="g-field">
              <span class="g-field__label">Message</span>
              <textarea class="g-input" name="contact[body]" rows="5" required></textarea>
            </label>
            <button type="submit" class="g-btn">
              Send message
              {% render 'icon', name: 'arrow' %}
            </button>
          {%- endform -%}
        </div>
      </div>
    </div>
  </section>

{%- else -%}
  <section class="g-pagehero">
    <div class="g-container">
      <ol class="g-crumbs">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li aria-current="page">{{ page.title | escape }}</li>
      </ol>
      <h1 class="g-h1">{{ page.title | escape }}</h1>
    </div>
  </section>

  <section class="g-section g-section--tight">
    <div class="g-container">
      <div class="g-story">
        <aside class="g-story__aside">
          <div class="g-fact">
            <p class="g-fact__k">Payment</p>
            <p class="g-fact__v">Cash on Delivery</p>
            <p class="g-fact__s">Pay the rider when your parcel arrives.</p>
          </div>
          <div class="g-fact">
            <p class="g-fact__k">Delivery</p>
            <p class="g-fact__v">All across Pakistan</p>
            <p class="g-fact__s">Usually 3 to 5 working days.</p>
          </div>
          {%- if wa != blank -%}
            <div class="g-fact">
              <p class="g-fact__k">Talk to us</p>
              <p class="g-fact__v">
                <a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{{ settings.whatsapp_display | default: wa | escape }}</a>
              </p>
              <p class="g-fact__s">A real person replies on WhatsApp.</p>
            </div>
          {%- endif -%}
          <a class="g-btn" href="{{ routes.all_products_collection_url }}">
            Shop the range
            {% render 'icon', name: 'arrow' %}
          </a>
        </aside>
        <div class="g-story__main g-rte">{{ page.content }}</div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "text",
      "id": "contact_handle",
      "label": "Contact page handle",
      "default": "contact",
      "info": "The page with this handle shows the contact layout and form."
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Contact page intro",
      "default": "Questions about your order, a return, or which product suits your skin? Message us on WhatsApp for the fastest reply, or use the form."
    }
  ]
}
{% endschema %}
