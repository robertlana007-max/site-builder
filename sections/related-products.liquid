{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign shown = 0
-%}
<section class="g-section g-section--lilac g-dots">
  <div class="g-container">
    <div class="g-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="g-h2">
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
        </h2>
      </div>
      <a class="g-link" href="{{ routes.all_products_collection_url }}">
        View all
        {% render 'icon', name: 'arrow' %}
      </a>
    </div>
    <div class="g-grid">
      {%- for item in source.products limit: 12 -%}
        {%- if item.id != product.id and shown < 4 -%}
          {% render 'product-card', product: item, lazy: true %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "More products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Complete the routine"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show from all products."
    }
  ]
}
{% endschema %}
