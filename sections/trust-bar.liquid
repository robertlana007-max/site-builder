<section class="g-section g-section--tight">
  <div class="g-container">
    <div class="g-trust">
      {%- for block in section.blocks -%}
        <div class="g-trust__item g-reveal" style="--g-delay: {{ forloop.index0 | times: 0.08 }}s" {{ block.shopify_attributes }}>
          <span class="g-trust__icon">{% render 'icon', name: block.settings.icon %}</span>
          <div>
            <p class="g-trust__title">{{ block.settings.title | escape }}</p>
            <p class="g-trust__text">{{ block.settings.text | escape }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust points",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "cash",
          "options": [
            {
              "value": "cash",
              "label": "Cash"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "return",
              "label": "Returns"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cash on Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Pay when it arrives"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust points",
      "blocks": [
        {
          "type": "point"
        }
      ]
    }
  ]
}
{% endschema %}
