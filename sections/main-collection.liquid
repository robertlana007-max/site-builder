{%- paginate collection.products by section.settings.per_page -%}
  <section class="g-pagehero">
    <div class="g-container">
      <ol class="g-crumbs">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><a href="{{ routes.collections_url }}">Collections</a></li>
        <li aria-current="page">{{ collection.title | escape }}</li>
      </ol>
      <h1 class="g-h1" style="font-size: clamp(36px, 5.4vw, 64px)">{{ collection.title | escape }}</h1>

      <nav class="g-chips" aria-label="Collections">
        <a
          class="g-chiplink{% if collection.handle == 'all' %} is-active{% endif %}"
          href="{{ routes.all_products_collection_url }}"
        >
          All
        </a>
        {%- for block in section.blocks -%}
          {%- assign chip = block.settings.collection -%}
          {%- if chip != blank -%}
            <a
              class="g-chiplink{% if chip.handle == collection.handle %} is-active{% endif %}"
              href="{{ chip.url }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | default: chip.title | escape -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>
  </section>

  <section class="g-section g-section--tight">
    <div class="g-container">
      <div class="g-toolbar">
        <span>
          {{ collection.products_count }}
          {% if collection.products_count == 1 %}product{% else %}products{% endif %}
        </span>
        <label>
          <span class="g-visually-hidden">Sort by</span>
          <select class="g-select" data-g-sort>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                {{ option.name | escape }}
              </option>
            {%- endfor -%}
          </select>
        </label>
      </div>

      {%- if collection.products.size > 0 -%}
        <div class="g-grid">
          {%- for product in collection.products -%}
            {%- if forloop.index > 4 -%}
              {% render 'product-card', product: product, lazy: true %}
            {%- else -%}
              {% render 'product-card', product: product, lazy: false %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="g-empty" style="padding-block: 60px">
          <h2 class="g-h3">No products here yet</h2>
          <p class="g-lead" style="margin-inline:auto">Have a look at the full range instead.</p>
          <p style="margin-top:22px"><a class="g-btn" href="{{ routes.all_products_collection_url }}">Shop all products</a></p>
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="g-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span {% if part.title == paginate.current_page %}class="is-current" aria-current="page"{% endif %}>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    </div>
  </section>

  {%- if collection.description != blank and paginate.current_page == 1 -%}
    <section class="g-section g-section--tight g-section--soft">
      <div class="g-container g-container--narrow">
        <p class="g-eyebrow">About {{ collection.title | escape }}</p>
        <div class="g-rte">{{ collection.description }}</div>
      </div>
    </section>
  {%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "max_blocks": 8,
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "collection_link",
      "name": "Collection link",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Leave empty to use the collection title."
        }
      ]
    }
  ]
}
{% endschema %}
