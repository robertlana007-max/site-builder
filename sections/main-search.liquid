<section class="g-pagehero">
  <div class="g-container">
    <h1 class="g-h1" style="font-size: clamp(36px, 5.4vw, 64px)">
      {%- if search.performed -%}
        Results for <em>{{ search.terms | escape }}</em>
      {%- else -%}
        Search
      {%- endif -%}
    </h1>
    <form class="g-searchform" action="{{ routes.search_url }}" method="get" role="search">
      <label class="g-visually-hidden" for="SearchInput">Search</label>
      <input
        class="g-input"
        id="SearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products"
      >
      <input type="hidden" name="type" value="product">
      <button class="g-btn" type="submit">Search</button>
    </form>
  </div>
</section>

<section class="g-section g-section--tight">
  <div class="g-container">
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count == 0 -%}
          <div class="g-empty" style="padding-block: 40px">
            <h2 class="g-h3">Nothing found</h2>
            <p class="g-lead" style="margin-inline:auto">Try a different word, or browse the full range.</p>
            <p style="margin-top:22px"><a class="g-btn" href="{{ routes.all_products_collection_url }}">Shop all products</a></p>
          </div>
        {%- else -%}
          <div class="g-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item, lazy: true %}
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <nav class="g-pagination" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>
              {%- endif -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="g-grid">
        {%- for product in collections.all.products limit: 8 -%}
          {% render 'product-card', product: product, lazy: true %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
