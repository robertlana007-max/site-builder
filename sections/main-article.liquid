<section class="g-pagehero">
  <div class="g-container g-container--narrow">
    <ol class="g-crumbs">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li>
    </ol>
    <p class="g-eyebrow">{{ article.published_at | date: '%d %B %Y' }}</p>
    <h1 class="g-h1">{{ article.title | escape }}</h1>
  </div>
</section>

<article class="g-section g-section--tight">
  <div class="g-container g-container--narrow">
    {%- if article.image -%}
      <img
        src="{{ article.image | image_url: width: 1400 }}"
        alt="{{ article.image.alt | escape }}"
        width="{{ article.image.width }}"
        height="{{ article.image.height }}"
        style="display:block;width:100%;height:auto;border-radius:var(--g-radius);margin-bottom:34px"
      >
    {%- endif -%}
    <div class="g-rte">{{ article.content }}</div>
    <p style="margin-top:40px">
      <a class="g-link" href="{{ blog.url }}">Back to {{ blog.title | escape }}</a>
    </p>
  </div>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
