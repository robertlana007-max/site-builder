{%- liquid
  assign shop_menu = linklists[section.settings.shop_menu]
  assign wa = settings.whatsapp_number | remove: '+' | remove: ' '
-%}
<footer class="g-footer">
  {%- if section.settings.wordmark != blank -%}
    <div class="g-footer__word" aria-hidden="true">
      <div class="g-footer__word-track">
        {%- for i in (1..2) -%}
          <div class="g-footer__word-group">
            {%- for n in (1..4) -%}
              <span>{{ section.settings.wordmark | escape }}</span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
  <div class="g-container">
    <div class="g-footer__top">
      <div class="g-footer__brand">
        <a class="g-logo" href="{{ routes.root_url }}">
          {%- if settings.logo != blank -%}
            <img
              class="g-logo__img"
              src="{{ settings.logo | image_url: width: 120, height: 120, crop: 'center' }}"
              alt=""
              width="42"
              height="42"
              loading="lazy"
            >
          {%- endif -%}
          <span class="g-logo__text">
            <span class="g-logo__name">{{ section.settings.brand_name | default: shop.name | escape }}</span>
            {%- if settings.logo_tagline != blank -%}
              <span class="g-logo__tag">{{ settings.logo_tagline | escape }}</span>
            {%- endif -%}
          </span>
        </a>
        {%- if section.settings.about != blank -%}
          <p class="g-footer__about">{{ section.settings.about | escape }}</p>
        {%- endif -%}
        <div class="g-social">
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
              {% render 'icon', name: 'facebook' %}
            </a>
          {%- endif -%}
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              {% render 'icon', name: 'instagram' %}
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
              {% render 'icon', name: 'tiktok' %}
            </a>
          {%- endif -%}
          {%- if wa != blank -%}
            <a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" aria-label="WhatsApp">
              {% render 'icon', name: 'whatsapp' %}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="g-footer__col">
        <h2 class="g-footer__title">Shop</h2>
        <ul class="g-footer__links">
          {%- if shop_menu.links.size > 0 -%}
            {%- for link in shop_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
            <li><a href="{{ routes.collections_url }}">Collections</a></li>
          {%- endif -%}
        </ul>
      </div>

      <div class="g-footer__col">
        <h2 class="g-footer__title">Help</h2>
        <ul class="g-footer__links">
          {%- for block in section.blocks -%}
            {%- if block.settings.link != blank and block.settings.label != blank -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="g-footer__col g-footer__col--wide">
        <h2 class="g-footer__title">{{ section.settings.news_title | escape }}</h2>
        <p style="margin:0">{{ section.settings.news_text | escape }}</p>
        {%- form 'customer', class: 'g-news', id: 'FooterNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="g-visually-hidden" for="FooterEmail">Email</label>
          <input
            class="g-news__input"
            id="FooterEmail"
            type="email"
            name="contact[email]"
            placeholder="Your email"
            autocomplete="email"
            required
          >
          <button class="g-news__btn" type="submit" aria-label="Subscribe">
            {% render 'icon', name: 'arrow' %}
          </button>
          {%- if form.posted_successfully? -%}
            <p class="g-footer__msg" style="flex-basis:100%">Thank you — you are on the list.</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <div class="g-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</p>
      <span class="g-footer__pay">
        {% render 'icon', name: 'cash' %}
        Cash on Delivery
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Glossira"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Big scrolling words",
      "default": "Glow on"
    },
    {
      "type": "textarea",
      "id": "about",
      "label": "About text",
      "default": "Simple, affordable skincare made for everyday use. Order online and pay only when it arrives at your door."
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "news_title",
      "label": "Newsletter heading",
      "default": "Join our email list"
    },
    {
      "type": "text",
      "id": "news_text",
      "label": "Newsletter text",
      "default": "Get deals and early access to new products."
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Help link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Contact us"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
