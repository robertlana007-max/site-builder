<section class="g-pagehero">
  <div class="g-container">
    <ol class="g-crumbs">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li aria-current="page">{{ blog.title | escape }}</li>
    </ol>
    <h1 class="g-h1">{{ blog.title | escape }}</h1>
  </div>
</section>

<section class="g-section g-section--tight">
  <div class="g-container">
    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="g-posts">
          {%- for article in blog.articles -%}
            <a class="g-post g-reveal" href="{{ article.url }}">
              {%- if article.image -%}
                <img
                  class="g-post__img"
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | escape }}"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="lazy"
                >
              {%- endif -%}
              <p class="g-post__date">{{ article.published_at | date: '%d %B %Y' }}</p>
              <h2 class="g-post__title">{{ article.title | escape }}</h2>
              <p class="g-post__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
            </a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="g-empty" style="padding-block: 40px">
          <h2 class="g-h3">Skincare notes are coming soon</h2>
          <p style="margin-top:22px"><a class="g-btn" href="{{ routes.all_products_collection_url }}">Shop all products</a></p>
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="g-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>
          {%- endif -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
