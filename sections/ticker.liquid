{%- if section.blocks.size > 0 -%}
  <div class="g-ticker" aria-hidden="true">
    <div class="g-ticker__track">
      {%- for i in (1..2) -%}
        <div class="g-ticker__group">
          {%- for n in (1..2) -%}
            {%- for block in section.blocks -%}
              <span class="g-ticker__item" {% if i == 1 and n == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {{- block.settings.text | escape -}}
              </span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Scrolling words",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "word",
      "name": "Word",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Aloe Vera"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling words",
      "blocks": [
        {
          "type": "word"
        }
      ]
    }
  ]
}
{% endschema %}
