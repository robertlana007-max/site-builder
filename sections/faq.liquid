<section class="g-section g-section--line">
  <div class="g-container">
    <div class="g-faq">
      <div class="g-faq__side">
        {%- if section.settings.eyebrow != blank -%}
          <p class="g-eyebrow g-reveal">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="g-h2 g-reveal" data-g-decode>
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="g-lead g-reveal">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if settings.whatsapp_number != blank -%}
          <p class="g-reveal" style="margin:26px 0 0">
            <a
              class="g-btn g-btn--wa"
              href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}"
              target="_blank"
              rel="noopener"
            >
              {% render 'icon', name: 'whatsapp' %}
              Ask us on WhatsApp
            </a>
          </p>
        {%- endif -%}
      </div>

      <div class="g-faq__list g-reveal">
        {%- for block in section.blocks -%}
          <details class="g-faq__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="g-faq__q">{{ block.settings.question | escape }}</summary>
            <div class="g-faq__a">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "questions"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do you offer Cash on Delivery?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. You pay when your order arrives, anywhere in Pakistan.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
