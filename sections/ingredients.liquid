{%- liquid
  assign core_product = section.settings.product
  assign first_block = section.blocks.first
-%}
<section class="g-section g-section--line" data-g-formula>
  <div class="g-container">
    <div class="g-formula">
      <div class="g-orbit g-reveal">
        <span class="g-orbit__path" aria-hidden="true"></span>
        <span class="g-orbit__path g-orbit__path--2" aria-hidden="true"></span>
        {%- if core_product.featured_image -%}
          <div class="g-orbit__core" aria-hidden="true">
            <img
              src="{{ core_product.featured_image | image_url: width: 400, height: 400, crop: 'center' }}"
              alt=""
              width="400"
              height="400"
              loading="lazy"
            >
          </div>
        {%- endif -%}
        <div class="g-orbit__ring" style="--g-n: {{ section.blocks.size }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="g-orbit__node"
              style="--g-i: {{ forloop.index0 }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              data-g-formula-node
              data-name="{{ block.settings.name | escape }}"
              data-text="{{ block.settings.text | escape }}"
              {{ block.shopify_attributes }}
            >
              <span><span>{{ block.settings.name | escape }}</span></span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="g-eyebrow g-reveal">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="g-h2 g-reveal" data-g-decode>
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="g-lead g-reveal">{{ section.settings.text | escape }}</p>
        {%- endif -%}

        <div class="g-formula__read g-glass g-reveal" aria-live="polite" data-g-formula-read>
          <p class="g-formula__k">{{ section.settings.read_label | escape }}</p>
          <h3 class="g-formula__name" data-g-formula-name>{{ first_block.settings.name | escape }}</h3>
          <p class="g-formula__text" data-g-formula-text>{{ first_block.settings.text | escape }}</p>
        </div>

        <ul class="g-visually-hidden">
          {%- for block in section.blocks -%}
            <li>{{ block.settings.name | escape }}: {{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formula orbit",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Formula"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredients you can"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "name"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tap an ingredient in orbit to see what it does."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product in the centre"
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "Readout label",
      "default": "Active ingredient"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Aloe Vera"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Hydrates and soothes."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Formula orbit",
      "blocks": [
        {
          "type": "ingredient"
        },
        {
          "type": "ingredient"
        },
        {
          "type": "ingredient"
        }
      ]
    }
  ]
}
{% endschema %}
