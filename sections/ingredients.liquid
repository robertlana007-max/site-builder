<section class="g-section g-section--dark" data-g-ingr>
  <div class="g-container">
    <div class="g-head g-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow g-reveal">
          {% render 'icon', name: 'star' %}
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}
      <h2 class="g-h2 g-reveal">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="g-lead g-reveal">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="g-ingr g-reveal">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="g-ingr__item"
          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          data-g-ingr-item
          data-text="{{ block.settings.name | append: ': ' | append: block.settings.text | escape }}"
          {{ block.shopify_attributes }}
        >
          {{- block.settings.name | escape -}}
        </button>
      {%- endfor -%}
    </div>

    <div class="g-ingr__out g-reveal">
      {% render 'mascot', tone: 'pink' %}
      <p class="g-say" style="margin:0" aria-live="polite" data-g-ingr-out>
        {%- assign first_block = section.blocks.first -%}
        {{- first_block.settings.name | append: ': ' | append: first_block.settings.text | escape -}}
      </p>
    </div>

    <ul class="g-visually-hidden">
      {%- for block in section.blocks -%}
        <li>{{ block.settings.name | escape }}: {{ block.settings.text | escape }}</li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sticker text",
      "default": "What is inside"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredients you can"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "name"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tap a bubble to see what it does."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Aloe Vera"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Hydrates and soothes."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        {
          "type": "ingredient"
        },
        {
          "type": "ingredient"
        },
        {
          "type": "ingredient"
        }
      ]
    }
  ]
}
{% endschema %}
