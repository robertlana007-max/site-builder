<section class="g-section g-section--dark">
  <div class="g-container">
    <div class="g-head g-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow g-eyebrow--center g-reveal">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="g-h2 g-reveal">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="g-lead g-reveal">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="g-ingr g-reveal">
      {%- for block in section.blocks -%}
        <div class="g-ingr__item" {{ block.shopify_attributes }}>
          <span class="g-ingr__num">No. {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="g-ingr__name">{{ block.settings.name | escape }}</h3>
          <p class="g-ingr__text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "max_blocks": 9,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "What is inside"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredients you can"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "name"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Aloe Vera"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Hydrates and soothes."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        {
          "type": "ingredient"
        },
        {
          "type": "ingredient"
        },
        {
          "type": "ingredient"
        }
      ]
    }
  ]
}
{% endschema %}
