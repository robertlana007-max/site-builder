{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
<div class="g-header-wrap">
  <header class="g-header" data-g-header>
    <div class="g-container g-header__inner">
      <button type="button" class="g-icon-btn g-menu-toggle" data-g-open="menu" aria-label="Open menu">
        {% render 'icon', name: 'menu' %}
      </button>

      <nav class="g-nav" aria-label="Main">
        {%- for link in menu.links -%}
          <a
            class="g-nav__link{% if link.active %} is-active{% endif %}"
            href="{{ link.url }}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title | escape -}}
          </a>
        {%- endfor -%}
      </nav>

      <a class="g-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if settings.logo != blank -%}
          <img
            class="g-logo__img"
            src="{{ settings.logo | image_url: width: 120, height: 120, crop: 'center' }}"
            alt=""
            width="42"
            height="42"
          >
        {%- endif -%}
        <span class="g-logo__text">
          <span class="g-logo__name">{{ section.settings.brand_name | default: shop.name | escape }}</span>
          {%- if settings.logo_tagline != blank -%}
            <span class="g-logo__tag">{{ settings.logo_tagline | escape }}</span>
          {%- endif -%}
        </span>
      </a>

      <div class="g-header__actions">
        <a class="g-icon-btn" href="{{ routes.search_url }}" aria-label="Search">
          {% render 'icon', name: 'search' %}
        </a>
        <a class="g-icon-btn" href="{{ routes.cart_url }}" data-g-open="cart" aria-label="Open cart">
          {% render 'icon', name: 'bag' %}
          <span class="g-cart-count" data-g-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
            {{- cart.item_count -}}
          </span>
        </a>
      </div>
    </div>
  </header>
</div>

<aside class="g-drawer g-drawer--left" data-g-drawer="menu" aria-hidden="true" aria-label="Menu">
  <div class="g-drawer__head">
    <h2 class="g-drawer__title">Menu</h2>
    <button type="button" class="g-icon-btn" data-g-close aria-label="Close menu">
      {% render 'icon', name: 'close' %}
    </button>
  </div>
  <div class="g-drawer__body">
    <nav class="g-mobile-nav" aria-label="Mobile">
      {%- for link in menu.links -%}
        <a class="g-mobile-nav__link" href="{{ link.url }}">
          {{ link.title | escape }}
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endfor -%}
    </nav>
  </div>
  {%- if settings.whatsapp_number != blank -%}
    <div class="g-drawer__foot">
      <p class="g-drawer__note">Need help choosing? A real person replies on WhatsApp.</p>
      <a
        class="g-btn g-btn--wa g-btn--block"
        href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}"
        target="_blank"
        rel="noopener"
      >
        {% render 'icon', name: 'whatsapp' %}
        Chat on WhatsApp
      </a>
    </div>
  {%- endif -%}
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Glossira",
      "info": "Leave empty to use the store name."
    }
  ]
}
{% endschema %}
