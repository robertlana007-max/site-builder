<section class="g-section g-section--tight">
  <div class="g-container">
    <div class="g-cta g-dots g-reveal">
      {%- for i in (1..4) -%}
        <span class="g-cta__heart g-cta__heart--{{ i }}" aria-hidden="true">{% render 'icon', name: 'heart' %}</span>
      {%- endfor -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="g-h2">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="g-lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <div class="g-cta__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="g-btn g-btn--gold g-wiggle" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.show_whatsapp and settings.whatsapp_number != blank -%}
          <a
            class="g-btn g-btn--light"
            href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}"
            target="_blank"
            rel="noopener"
          >
            {% render 'icon', name: 'whatsapp' %}
            {{ settings.whatsapp_display | default: 'WhatsApp' | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call to action",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Order today"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start your glow routine,"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "pay on delivery"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Free Cash on Delivery across Pakistan. We confirm every order on WhatsApp before it is dispatched."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Call to action"
    }
  ]
}
{% endschema %}
