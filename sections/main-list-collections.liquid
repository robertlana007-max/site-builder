<section class="g-pagehero">
  <div class="g-container">
    <ol class="g-crumbs">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li aria-current="page">Collections</li>
    </ol>
    <h1 class="g-h1">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="g-lead">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>
</section>

<section class="g-section g-section--tight">
  <div class="g-container">
    {%- paginate collections by 24 -%}
      <div class="g-collcards">
        {%- for item in collections -%}
          {%- if item.handle != 'frontpage' and item.products_count > 0 -%}
            {%- assign card_image = item.image | default: item.products.first.featured_image -%}
            <a class="g-collcard g-reveal" href="{{ item.url }}">
              {%- if card_image != blank -%}
                <img
                  src="{{ card_image | image_url: width: 700 }}"
                  alt=""
                  width="{{ card_image.width }}"
                  height="{{ card_image.height }}"
                  loading="lazy"
                >
              {%- endif -%}
              <div class="g-collcard__body">
                <h2 class="g-collcard__title">{{ item.title | escape }}</h2>
                <p class="g-collcard__meta">
                  {{ item.products_count }}
                  {% if item.products_count == 1 %}product{% else %}products{% endif %}
                </p>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
        <a class="g-collcard g-collcard--all g-reveal" href="{{ routes.all_products_collection_url }}">
          <div class="g-collcard__body">
            <h2 class="g-collcard__title">All products</h2>
            <p class="g-collcard__meta">See everything in one place</p>
          </div>
        </a>
      </div>
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Brightening cream, gentle face washes and value deals that combine them."
    }
  ]
}
{% endschema %}
