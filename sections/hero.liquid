{%- liquid
  assign hero_product = section.settings.product
  assign hero_image = section.settings.image
  if hero_image == blank and hero_product != blank
    assign position = section.settings.image_position | minus: 1
    assign hero_image = hero_product.images[position] | default: hero_product.featured_image
  endif
  assign primary_link = section.settings.button_link
  if primary_link == blank and hero_product != blank
    assign primary_link = hero_product.url
  endif
  assign sat_index = 0
-%}
<section class="g-hero">
  <canvas class="g-hero__canvas" data-g-orb aria-hidden="true"></canvas>

  {%- if section.settings.hud_left != blank -%}
    <div class="g-hud g-hud--tl" aria-hidden="true">{{ section.settings.hud_left | escape }}</div>
  {%- endif -%}
  <div class="g-hud g-hud--tr" aria-hidden="true">PKT <b data-g-clock>--:--:--</b></div>
  <div class="g-hud g-hud--bl" aria-hidden="true">Scroll</div>
  {%- if section.settings.hud_right != blank -%}
    <div class="g-hud g-hud--br" aria-hidden="true">{{ section.settings.hud_right | escape }}</div>
  {%- endif -%}

  <div class="g-container g-hero__inner">
    <div class="g-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="g-h1" data-g-decode>
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
        {%- if section.settings.heading_end != blank %} {{ section.settings.heading_end | escape }}{% endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="g-hero__sub">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <div class="g-hero__cta">
        {%- if section.settings.button_label != blank -%}
          <a class="g-btn g-wiggle" href="{{ primary_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="g-btn g-btn--ghost" href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_2_label | escape }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="g-hero__points">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="g-core" data-g-core>
      <span class="g-core__ring g-core__ring--3" aria-hidden="true"></span>
      <span class="g-core__ring g-core__ring--1" aria-hidden="true"></span>
      <span class="g-core__ring g-core__ring--2" aria-hidden="true"></span>

      <a class="g-core__product" href="{{ primary_link | default: routes.all_products_collection_url }}">
        {%- if hero_image != blank -%}
          <img
            src="{{ hero_image | image_url: width: 900, height: 900, crop: 'center' }}"
            srcset="{{ hero_image | image_url: width: 500, height: 500, crop: 'center' }} 500w, {{ hero_image | image_url: width: 900, height: 900, crop: 'center' }} 900w"
            sizes="(min-width: 900px) 340px, 60vw"
            alt="{{ hero_image.alt | default: hero_product.title | default: shop.name | escape }}"
            width="900"
            height="900"
            fetchpriority="high"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </a>

      <div class="g-core__orbit">
        {%- for sat in section.settings.stickers.products limit: 6 -%}
          {%- if sat.id != hero_product.id and sat_index < 3 and sat.featured_image -%}
            <div class="g-core__sat" style="--i: {{ sat_index }}">
              <a href="{{ sat.url }}" aria-label="{{ sat.title | escape }}">
                <img
                  src="{{ sat.featured_image | image_url: width: 200, height: 200, crop: 'center' }}"
                  alt=""
                  width="200"
                  height="200"
                  loading="lazy"
                >
              </a>
            </div>
            {%- assign sat_index = sat_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if hero_product != blank -%}
        <a class="g-core__tag" href="{{ hero_product.url }}">
          {{ section.settings.chip_label | escape }}
          <b>{{ hero_product.price | money_without_trailing_zeros }}</b>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Glow system online"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The future of your"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "glow"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading end"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A brightening cream and gentle face washes for morning and night. Delivered all over Pakistan, and you pay only when it arrives."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use a photo of the featured product."
    },
    {
      "type": "range",
      "id": "image_position",
      "label": "Which product photo to use",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 1
    },
    {
      "type": "collection",
      "id": "stickers",
      "label": "Orbiting products",
      "info": "The first three other products of this collection orbit the photo."
    },
    {
      "type": "text",
      "id": "chip_label",
      "label": "Price label",
      "default": "Bestseller"
    },
    {
      "type": "text",
      "id": "hud_left",
      "label": "Corner text, top left",
      "default": "Glossira // Glow Lab"
    },
    {
      "type": "text",
      "id": "hud_right",
      "label": "Corner text, bottom right",
      "default": "Made in Pakistan"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the bestseller"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to the featured product."
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "default": "See the deals"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Cash on Delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "point"
        }
      ]
    }
  ]
}
{% endschema %}
