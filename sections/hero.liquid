{%- liquid
  assign hero_product = section.settings.product
  assign hero_image = section.settings.image
  if hero_image == blank and hero_product != blank
    assign position = section.settings.image_position | minus: 1
    assign hero_image = hero_product.images[position] | default: hero_product.featured_image
  endif
  assign primary_link = section.settings.button_link
  if primary_link == blank and hero_product != blank
    assign primary_link = hero_product.url
  endif
-%}
<section class="g-hero">
  <div class="g-container g-hero__inner">
    <div class="g-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="g-h1">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="g-hero__sub">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <div class="g-hero__cta">
        {%- if section.settings.button_label != blank -%}
          <a class="g-btn" href="{{ primary_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="g-btn g-btn--ghost" href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_2_label | escape }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="g-hero__points">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {% render 'icon', name: 'check' %}
              {{ block.settings.text | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="g-hero__visual">
      <span class="g-hero__ring" aria-hidden="true"></span>
      <div class="g-hero__frame">
        {%- if hero_image != blank -%}
          <img
            src="{{ hero_image | image_url: width: 1000 }}"
            srcset="{{ hero_image | image_url: width: 600 }} 600w, {{ hero_image | image_url: width: 1000 }} 1000w, {{ hero_image | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 900px) 500px, 86vw"
            alt="{{ hero_image.alt | default: hero_product.title | default: shop.name | escape }}"
            width="{{ hero_image.width }}"
            height="{{ hero_image.height }}"
            fetchpriority="high"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      {%- if hero_product != blank -%}
        <a class="g-chip g-chip--a" href="{{ hero_product.url }}">
          <span class="g-chip__icon">{% render 'icon', name: 'sparkle' %}</span>
          <span>
            <span class="g-chip__label">{{ section.settings.chip_label | escape }}</span>
            <span class="g-chip__value">{{ hero_product.price | money_without_trailing_zeros }}</span>
          </span>
        </a>
      {%- endif -%}
      <div class="g-chip g-chip--b">
        <span class="g-chip__icon">{% render 'icon', name: 'cash' %}</span>
        <span>
          <span class="g-chip__label">Pay at your door</span>
          <span class="g-chip__value">Free COD</span>
        </span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Everyday skincare, made simple"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Skincare for your"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "everyday glow"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A brightening cream and gentle face washes made for morning and night. Delivered across Pakistan, and you pay only when it arrives."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use a photo of the featured product."
    },
    {
      "type": "range",
      "id": "image_position",
      "label": "Which product photo to use",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 1
    },
    {
      "type": "text",
      "id": "chip_label",
      "label": "Price label",
      "default": "Bestseller from"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the bestseller"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to the featured product."
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "default": "See all products"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Cash on Delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "point"
        }
      ]
    }
  ]
}
{% endschema %}
