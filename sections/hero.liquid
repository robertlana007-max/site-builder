{%- liquid
  assign hero_product = section.settings.product
  assign hero_image = section.settings.image
  if hero_image == blank and hero_product != blank
    assign position = section.settings.image_position | minus: 1
    assign hero_image = hero_product.images[position] | default: hero_product.featured_image
  endif
  assign primary_link = section.settings.button_link
  if primary_link == blank and hero_product != blank
    assign primary_link = hero_product.url
  endif
  assign sticker_index = 0
-%}
<section class="g-hero g-dots" data-g-parallax-root>
  <span class="g-doodle g-doodle--a" aria-hidden="true">{% render 'icon', name: 'star' %}</span>
  <span class="g-doodle g-doodle--b" aria-hidden="true">{% render 'icon', name: 'heart' %}</span>
  <span class="g-doodle g-doodle--c" aria-hidden="true">{% render 'icon', name: 'star' %}</span>

  <div class="g-container g-hero__inner">
    <div class="g-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">
          {% render 'icon', name: 'heart' %}
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}
      <h1 class="g-h1">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
        {%- if section.settings.heading_end != blank %} {{ section.settings.heading_end | escape }}{% endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="g-hero__sub">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <div class="g-hero__cta">
        {%- if section.settings.button_label != blank -%}
          <a class="g-btn g-wiggle" href="{{ primary_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="g-btn g-btn--ghost" href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_2_label | escape }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="g-hero__points">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {% render 'icon', name: 'check' %}
              {{ block.settings.text | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="g-hero__visual">
      <span class="g-hero__blob" aria-hidden="true"></span>
      <a class="g-hero__frame" href="{{ primary_link | default: routes.all_products_collection_url }}" data-g-depth="6">
        {%- if hero_image != blank -%}
          <img
            src="{{ hero_image | image_url: width: 1000 }}"
            srcset="{{ hero_image | image_url: width: 600 }} 600w, {{ hero_image | image_url: width: 1000 }} 1000w, {{ hero_image | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 900px) 420px, 76vw"
            alt="{{ hero_image.alt | default: hero_product.title | default: shop.name | escape }}"
            width="{{ hero_image.width }}"
            height="{{ hero_image.height }}"
            fetchpriority="high"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </a>

      {%- for sticker in section.settings.stickers.products limit: 6 -%}
        {%- if sticker.id != hero_product.id and sticker_index < 3 and sticker.featured_image -%}
          {%- assign sticker_index = sticker_index | plus: 1 -%}
          <a
            class="g-sticker g-sticker--{{ sticker_index }}"
            href="{{ sticker.url }}"
            aria-label="{{ sticker.title | escape }}"
            data-g-depth="{{ sticker_index | times: 9 | plus: 10 }}"
          >
            <img
              src="{{ sticker.featured_image | image_url: width: 300, height: 300, crop: 'center' }}"
              alt=""
              width="300"
              height="300"
              loading="lazy"
            >
          </a>
        {%- endif -%}
      {%- endfor -%}

      <div class="g-hero__mascot" data-g-depth="16" aria-hidden="true">
        {% render 'mascot', tone: 'pink' %}
      </div>

      {%- if section.settings.badge_text != blank -%}
        <div class="g-spin" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="58" fill="#ffdd55" stroke="#4b1528" stroke-width="2.5"/>
            <g class="g-spin__ring">
              <path id="HeroSpin-{{ section.id }}" d="M60 60m-43 0a43 43 0 1 1 86 0a43 43 0 1 1-86 0" fill="none"/>
              <text><textPath href="#HeroSpin-{{ section.id }}" startOffset="0">{{ section.settings.badge_text | escape }}</textPath></text>
            </g>
            <circle cx="60" cy="60" r="25" fill="#d4537e" stroke="#4b1528" stroke-width="2.5"/>
            <path d="M60 71s-11-6.7-11-14.5a6.3 6.3 0 0 1 11-3.8 6.3 6.3 0 0 1 11 3.8C71 64.3 60 71 60 71z" fill="#fff"/>
          </svg>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sticker text",
      "default": "Hi gorgeous!"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "glow-up"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading end",
      "default": "starts here"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A brightening cream and gentle face washes for morning and night. We deliver all over Pakistan and you pay only when your goodies arrive."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use a photo of the featured product."
    },
    {
      "type": "range",
      "id": "image_position",
      "label": "Which product photo to use",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 1
    },
    {
      "type": "collection",
      "id": "stickers",
      "label": "Floating product stickers",
      "info": "The first three other products of this collection float around the photo."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Spinning badge text",
      "default": "FREE CASH ON DELIVERY ✦ ALL OVER PAKISTAN ✦ "
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the bestseller"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to the featured product."
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "default": "See the deals"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Cash on Delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "point"
        }
      ]
    }
  ]
}
{% endschema %}
