<section class="g-empty">
  <div class="g-container g-container--narrow">
    <p class="g-eyebrow">{{ shop.name | escape }}</p>
    <h1 class="g-h2">Opening <em>soon</em></h1>
    {%- if shop.password_message != blank -%}
      <p class="g-lead" style="margin-inline:auto">{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'storefront_password', class: 'g-searchform' -%}
      <label class="g-visually-hidden" for="Password">Password</label>
      <input class="g-input" id="Password" type="password" name="password" placeholder="Enter store password" autocomplete="current-password">
      <button class="g-btn" type="submit">Enter</button>
      {%- if form.errors -%}
        <p class="g-alert g-alert--error" style="flex-basis:100%">Wrong password. Please try again.</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
