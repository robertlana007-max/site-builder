{%- liquid
  assign spot = section.settings.product
  assign position = section.settings.image_position | minus: 1
  assign spot_image = spot.images[position] | default: spot.featured_image
  assign variant = spot.selected_or_first_available_variant
-%}
<section class="g-section g-section--line">
  <div class="g-container">
    <div class="g-spot">
      <div class="g-spot__media g-reveal">
        {%- if spot_image != blank -%}
          <img
            src="{{ spot_image | image_url: width: 1000 }}"
            srcset="{{ spot_image | image_url: width: 600 }} 600w, {{ spot_image | image_url: width: 1000 }} 1000w, {{ spot_image | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 900px) 46vw, 92vw"
            alt="{{ spot_image.alt | default: spot.title | escape }}"
            width="{{ spot_image.width }}"
            height="{{ spot_image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
        {%- if section.settings.stamp_top != blank or section.settings.stamp_bottom != blank -%}
          <div class="g-spot__stamp" aria-hidden="true">
            {% render 'icon', name: 'burst' %}
            <span><b>{{ section.settings.stamp_top | escape }}</b>{{ section.settings.stamp_bottom | escape }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="g-spot__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="g-eyebrow g-reveal">
            {% render 'icon', name: 'star' %}
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}
        <h2 class="g-h2 g-reveal" data-g-decode>
          {{ section.settings.heading | default: spot.title | escape }}
          {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="g-lead g-reveal">{{ section.settings.text | escape }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="g-checks g-reveal">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'icon', name: 'check' %}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if spot != blank -%}
          <div class="g-spot__buy g-reveal">
            {% render 'price', product: spot, show_saving: true %}
          </div>
          <div class="g-spot__buy g-reveal" style="margin-top:20px">
            {%- if spot.available -%}
              {%- form 'product', spot, data-g-product-form: '' -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="g-btn">
                  {% render 'icon', name: 'bag' %}
                  Add to cart
                </button>
              {%- endform -%}
            {%- endif -%}
            <a class="g-link" href="{{ spot.url }}">
              Product details
              {% render 'icon', name: 'arrow' %}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "max_blocks": 6,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "range",
      "id": "image_position",
      "label": "Which product photo to use",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 1
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Bestseller"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the product title."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "stamp_top",
      "label": "Round badge, large text",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "stamp_bottom",
      "label": "Round badge, small text",
      "default": "Cash on Delivery"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Lightweight, non-greasy formula"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product spotlight",
      "blocks": [
        {
          "type": "point"
        }
      ]
    }
  ]
}
{% endschema %}
