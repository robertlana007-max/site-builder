<section class="g-pagehero">
  <div class="g-container">
    <h1 class="g-h1">Your cart</h1>
  </div>
</section>

<section class="g-section g-section--tight">
  <div class="g-container g-container--narrow">
    {%- if cart.item_count == 0 -%}
      <div class="g-cart-empty">
        {% render 'icon', name: 'bag' %}
        <p>Your cart is empty</p>
        <a class="g-btn" href="{{ routes.all_products_collection_url }}">Shop the range</a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="g-line">
          {%- if item.image -%}
            <img class="g-line__img" src="{{ item.image | image_url: width: 200 }}" alt="" loading="lazy" width="78" height="96">
          {%- else -%}
            <div class="g-line__img"></div>
          {%- endif -%}
          <div>
            <a class="g-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
            <div class="g-line__row">
              <span>Qty {{ item.quantity }}</span>
              <span class="g-line__price">{{ item.final_line_price | money_without_trailing_zeros }}</span>
            </div>
            <a class="g-line__remove" href="{{ item.url_to_remove }}">Remove</a>
          </div>
        </div>
      {%- endfor -%}
      <div class="g-cart-total" style="margin-top:22px">
        <span>Total</span>
        <span>{{ cart.total_price | money_without_trailing_zeros }}</span>
      </div>
      <p class="g-drawer__note">Free delivery &middot; Pay cash when your parcel arrives</p>
      <a
        class="g-btn g-btn--block"
        href="{% if settings.custom_checkout_url != blank %}{{ settings.custom_checkout_url }}{% else %}{{ routes.root_url | append: 'checkout' | replace: '//', '/' }}{% endif %}"
      >
        Checkout &middot; Cash on Delivery
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
