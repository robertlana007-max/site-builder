{%- liquid
  assign featured = section.settings.collection
  assign view_all = section.settings.link | default: featured.url
-%}
<section class="g-section{% if section.settings.soft_background %} g-section--soft{% endif %}">
  <div class="g-container">
    <div class="g-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="g-eyebrow g-reveal">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="g-h2 g-reveal">
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="g-lead g-reveal">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and view_all != blank -%}
        <a class="g-link" href="{{ view_all }}">
          {{ section.settings.link_label | escape }}
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <div class="g-grid">
      {%- for product in featured.products limit: section.settings.limit -%}
        {% render 'product-card', product: product, lazy: true %}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="g-card">
            <div class="g-card__media">{{ 'product-1' | placeholder_svg_tag }}</div>
            <div class="g-card__body">
              <h3 class="g-card__title">Product title</h3>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "The range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "essentials"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Leave empty to link to the collection."
    },
    {
      "type": "checkbox",
      "id": "soft_background",
      "label": "Soft background",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
