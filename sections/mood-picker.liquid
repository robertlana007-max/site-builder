<section class="g-section" data-g-scan>
  <div class="g-container">
    <div class="g-scan">
      <div class="g-scan__lens g-reveal" aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- assign pick = block.settings.product -%}
          {%- if pick.featured_image -%}
            <img
              class="g-scan__img{% if forloop.first %} is-active{% endif %}"
              src="{{ pick.featured_image | image_url: width: 800, height: 800, crop: 'center' }}"
              alt=""
              width="800"
              height="800"
              loading="lazy"
              data-g-scan-img
            >
          {%- else -%}
            <span class="g-scan__img" data-g-scan-img></span>
          {%- endif -%}
        {%- endfor -%}
        <span class="g-scan__beam"></span>
        <span
          class="g-scan__status"
          data-g-scan-status
          data-busy="{{ section.settings.status_busy | escape }}"
          data-done="{{ section.settings.status_done | escape }}"
        >
          {{- section.settings.status_done | escape -}}
        </span>
      </div>

      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="g-eyebrow g-reveal">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="g-h2 g-reveal" data-g-decode>
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="g-lead g-reveal">{{ section.settings.text | escape }}</p>
        {%- endif -%}

        <div class="g-scan__tabs g-reveal" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="g-scan__tab"
              role="tab"
              id="ScanTab-{{ block.id }}"
              aria-controls="ScanPanel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-g-scan-tab
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.emoji != blank -%}
                <span class="g-scan__emoji" aria-hidden="true">{{ block.settings.emoji | escape }}</span>
              {%- endif -%}
              {{ block.settings.label | escape }}
            </button>
          {%- endfor -%}
        </div>

        <div class="g-scan__result g-glass g-reveal">
          {%- for block in section.blocks -%}
            {%- liquid
              assign pick = block.settings.product
              capture tone
                render 'product-tone', handle: pick.handle
              endcapture
              assign tone = tone | strip
              assign pick_parts = pick.title | split: ' — '
              assign pick_variant = pick.selected_or_first_available_variant
            -%}
            <div
              class="g-scan__panel g-tone-{{ tone }}"
              role="tabpanel"
              id="ScanPanel-{{ block.id }}"
              aria-labelledby="ScanTab-{{ block.id }}"
              data-g-scan-panel
              {% unless forloop.first %}
                hidden
              {% endunless %}
            >
              <p class="g-scan__say">{{ block.settings.say | escape }}</p>
              {%- if pick != blank -%}
                <h3 class="g-scan__name"><a href="{{ pick.url }}">{{ pick_parts.first | escape }}</a></h3>
                <p class="g-scan__why">{{ block.settings.why | escape }}</p>
                <div class="g-scan__buy">
                  {% render 'price', product: pick, show_saving: true %}
                  {%- if pick.available -%}
                    {%- form 'product', pick, data-g-product-form: '' -%}
                      <input type="hidden" name="id" value="{{ pick_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="g-btn g-btn--sm">
                        {% render 'icon', name: 'bag' %}
                        Add to cart
                      </button>
                    {%- endform -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Skin scanner",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Skin scanner"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How is your skin"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "today?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Pick a skin state and the scanner finds your match."
    },
    {
      "type": "text",
      "id": "status_busy",
      "label": "Status while scanning",
      "default": "Scanning"
    },
    {
      "type": "text",
      "id": "status_done",
      "label": "Status when done",
      "default": "Match found"
    }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Skin state",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Oily and shiny"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "say",
          "label": "Small line above the product",
          "default": "Recommended for you"
        },
        {
          "type": "textarea",
          "id": "why",
          "label": "Why this product",
          "default": "A short reason this product fits this skin state."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skin scanner",
      "blocks": [
        {
          "type": "mood"
        },
        {
          "type": "mood"
        }
      ]
    }
  ]
}
{% endschema %}
