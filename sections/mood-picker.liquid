<section class="g-section g-section--lilac g-dots" data-g-mood>
  <div class="g-container">
    <div class="g-head g-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow g-reveal">
          {% render 'icon', name: 'star' %}
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}
      <h2 class="g-h2 g-reveal">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="g-lead g-reveal">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="g-mood__tabs g-reveal" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="g-mood__tab"
          role="tab"
          id="MoodTab-{{ block.id }}"
          aria-controls="MoodPanel-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          data-g-mood-tab
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.emoji != blank -%}
            <span class="g-mood__emoji" aria-hidden="true">{{ block.settings.emoji | escape }}</span>
          {%- endif -%}
          {{ block.settings.label | escape }}
        </button>
      {%- endfor -%}
    </div>

    <div class="g-mood__stage">
      {%- for block in section.blocks -%}
        {%- liquid
          assign pick = block.settings.product
          capture tone
            render 'product-tone', handle: pick.handle
          endcapture
          assign tone = tone | strip
          assign pick_parts = pick.title | split: ' — '
          assign pick_variant = pick.selected_or_first_available_variant
        -%}
        <div
          class="g-mood__panel g-tone-{{ tone }}"
          role="tabpanel"
          id="MoodPanel-{{ block.id }}"
          aria-labelledby="MoodTab-{{ block.id }}"
          data-g-mood-panel
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          <a class="g-mood__media" href="{{ pick.url | default: routes.all_products_collection_url }}" tabindex="-1" aria-hidden="true">
            {%- if pick.featured_image -%}
              <img
                src="{{ pick.featured_image | image_url: width: 800, height: 800, crop: 'center' }}"
                alt=""
                width="800"
                height="800"
                loading="lazy"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </a>
          <div>
            <div class="g-buddy">
              {% render 'mascot', tone: tone %}
              <p class="g-say" style="margin:0">{{ block.settings.say | escape }}</p>
            </div>
            {%- if pick != blank -%}
              <h3 class="g-mood__name"><a href="{{ pick.url }}">{{ pick_parts.first | escape }}</a></h3>
              <p class="g-mood__why">{{ block.settings.why | escape }}</p>
              <div class="g-mood__buy">
                {% render 'price', product: pick, show_saving: true %}
                {%- if pick.available -%}
                  {%- form 'product', pick, data-g-product-form: '' -%}
                    <input type="hidden" name="id" value="{{ pick_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="g-btn">
                      {% render 'icon', name: 'bag' %}
                      Add to cart
                    </button>
                  {%- endform -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Skin mood picker",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sticker text",
      "default": "Find your match"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What is your skin"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "mood today?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tap a mood and we will pick your goodie."
    }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Mood",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Oily and shiny"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "say",
          "label": "What the mascot says",
          "default": "Pick me!"
        },
        {
          "type": "textarea",
          "id": "why",
          "label": "Why this product",
          "default": "A short reason this product fits this mood."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skin mood picker",
      "blocks": [
        {
          "type": "mood"
        },
        {
          "type": "mood"
        }
      ]
    }
  ]
}
{% endschema %}
