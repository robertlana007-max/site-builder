<section class="g-section g-section--line">
  <div class="g-container">
    <div class="g-head g-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow g-reveal">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="g-h2 g-reveal" data-g-decode>
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="g-lead g-reveal">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="g-steps" data-g-steps>
      {%- for block in section.blocks -%}
        <div class="g-step g-reveal" style="--g-delay: {{ forloop.index0 | times: 0.1 }}s" {{ block.shopify_attributes }}>
          <p class="g-step__k">{{ block.settings.kicker | escape }}</p>
          <h3 class="g-step__title">{{ block.settings.title | escape }}</h3>
          <p class="g-step__text">{{ block.settings.text | escape }}</p>
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a class="g-step__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} &rarr;</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Routine steps",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "How to use"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your simple glow"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "routine"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "soft_background",
      "label": "Soft background",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cleanse"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Wash with a gentle face wash, morning and night."
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Small label",
          "default": "Morning and night"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine steps",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
