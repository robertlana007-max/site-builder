<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#3a1528">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.google_site_verification != blank -%}
      <meta name="google-site-verification" content="{{ settings.google_site_verification | escape }}">
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 192, height: 192, crop: 'center' }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {% render 'fonts' %}

    {{ 'glossira.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('g-js');
      window.GlossiraTheme = {
        customCheckout: {% if settings.custom_checkout_url != blank %}true{% else %}false{% endif %},
        checkoutUrl: {% if settings.custom_checkout_url != blank %}{{ settings.custom_checkout_url | json }}{% else %}{{ routes.root_url | append: 'checkout' | replace: '//', '/' | json }}{% endif %},
        currency: {{ cart.currency.iso_code | json }},
        moneyPrefix: {{ settings.money_prefix | json }},
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        }
      };
      {%- if settings.custom_checkout_url != blank and request.page_type == 'cart' %}
        window.location.replace({{ settings.custom_checkout_url | json }});
      {%- endif %}
    </script>

    {{ content_for_header }}

    {%- if settings.hide_cookie_banner -%}
      <style>
        #shopify-pc__banner,
        .shopify-pc__banner,
        #shopify-pc__prefs {
          display: none !important;
        }
      </style>
    {%- endif -%}

    {%- if settings.meta_pixel_id != blank -%}
      <!-- Meta Pixel -->
      <script>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', {{ settings.meta_pixel_id | json }});
        fbq('track', 'PageView');
      </script>
      <noscript>
        <img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id={{ settings.meta_pixel_id | url_encode }}&ev=PageView&noscript=1">
      </noscript>
    {%- endif -%}
  </head>

  <body class="g-body g-template-{{ template.name | handleize }}">
    <a class="g-skip" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="g-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

    {%- if settings.whatsapp_float and settings.whatsapp_number != blank -%}
      <a
        class="g-wa-float"
        href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}?text={{ settings.whatsapp_message | url_encode }}"
        target="_blank"
        rel="noopener"
        aria-label="Chat with us on WhatsApp"
      >
        {% render 'icon', name: 'whatsapp' %}
      </a>
    {%- endif -%}

    <script
      src="{{ 'glossira.js' | asset_url }}"
      defer
      onerror="document.documentElement.classList.remove('g-js')"
    ></script>
  </body>
</html>
