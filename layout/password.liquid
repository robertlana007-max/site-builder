<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'fonts' %}
    {{ 'glossira.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="g-body">
    <main id="MainContent" class="g-main" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
