[
  {
    "name": "theme_info",
    "theme_name": "Glossira",
    "theme_version": "1.0.0",
    "theme_author": "Glossira Organic",
    "theme_documentation_url": "https://glossiraorganic.com",
    "theme_support_url": "https://glossiraorganic.com/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo mark",
        "info": "Shown as a small round mark beside the store name."
      },
      {
        "type": "text",
        "id": "logo_tagline",
        "label": "Tagline under the name",
        "default": "Organic"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Checkout",
    "settings": [
      {
        "type": "text",
        "id": "custom_checkout_url",
        "label": "Custom checkout page",
        "default": "/pages/checkout",
        "info": "Cart and checkout buttons go to this page. Leave empty to use the standard Shopify checkout."
      },
      {
        "type": "text",
        "id": "raw_page_handles",
        "label": "Pages shown without theme styling",
        "default": "checkout,thank-you",
        "info": "Page handles separated by commas. These pages keep their own design exactly as written."
      },
      {
        "type": "text",
        "id": "money_prefix",
        "label": "Currency prefix in the cart drawer",
        "default": "Rs."
      }
    ]
  },
  {
    "name": "Contact and social",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number",
        "default": "923097178187",
        "info": "With country code, digits only."
      },
      {
        "type": "text",
        "id": "whatsapp_display",
        "label": "Phone number as displayed",
        "default": "+92 309 7178187"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "Prefilled WhatsApp message",
        "default": "Assalam o Alaikum, I have a question about Glossira."
      },
      {
        "type": "checkbox",
        "id": "whatsapp_float",
        "label": "Show floating WhatsApp button",
        "default": true,
        "info": "Turn this off if a WhatsApp app already adds its own button."
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Contact email"
      },
      {
        "type": "text",
        "id": "contact_address",
        "label": "Address",
        "default": "Qulander Colony, Near AIML College, Ahmadpur East, Punjab 63350, Pakistan"
      },
      {
        "type": "text",
        "id": "contact_hours",
        "label": "Opening hours",
        "default": "Monday to Saturday (closed on Sundays)"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook link"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram link"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok link"
      }
    ]
  },
  {
    "name": "Tracking",
    "settings": [
      {
        "type": "text",
        "id": "meta_pixel_id",
        "label": "Meta Pixel ID",
        "info": "Leave empty if the Facebook and Instagram app already adds your pixel."
      },
      {
        "type": "text",
        "id": "google_site_verification",
        "label": "Google site verification code"
      },
      {
        "type": "checkbox",
        "id": "hide_cookie_banner",
        "label": "Hide the cookie banner",
        "default": true
      }
    ]
  }
]
